id-ldx                                   ID ::= ldap-x509        -- 
id-lat                                   ID ::= ldap-attr
id-lmr                                   ID ::= ldap-match
id-oat                                   ID ::= openLDAP-attributes
id-coat                                  ID ::= cosineAttr
id-avr                                   ID ::= avRestriction
id-cmsct                                 ID ::= cmsContentType
id-wrprot                                ID ::= wrapperProtocolType
id-algo                                  ID ::= algorithm

