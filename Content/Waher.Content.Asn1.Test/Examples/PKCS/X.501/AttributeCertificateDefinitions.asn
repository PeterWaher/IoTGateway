-- id-mr-roleSpecCertIdMatch                OBJECT IDENTIFIER ::= {id-mr 54} obsolete, X.509 (2019) Cor.3 (2026) DR 441
-- id-mr-basicAttConstraintsMatch           OBJECT IDENTIFIER ::= {id-mr 55} obsolete, X.509 (2019) Cor.3 (2026) DR 441
