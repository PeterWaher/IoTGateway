			<String id="100">Matter</String>
			<String id="101">Operational Node ID:</String>
			<String id="102">Operational node ID of the device in the fabric (hexadecimal).</String>
			<String id="103">UDP Port:</String>
			<String id="104">UDP port of the device. The address is updated automatically if the device announces a new address on the network.</String>
			<String id="105">Subscribe to changes.</String>
			<String id="106">If the gateway should subscribe to changes on the device, and report them as momentary values.</String>
			<String id="107">Minimum interval (s):</String>
			<String id="108">Minimum interval between change reports, in seconds.</String>
			<String id="109">Maximum interval (s):</String>
			<String id="110">Maximum interval between reports, in seconds. The device may choose a longer interval. Used to detect if the device is lost.</String>
			<String id="111">Remove device from fabric when node is deleted.</String>
			<String id="112">If the gateway should remove itself as administrator from the device, when the node is deleted.</String>
			<String id="113">Include endpoints in readout.</String>
			<String id="114">If values from all endpoints should be included when reading the device node.</String>
