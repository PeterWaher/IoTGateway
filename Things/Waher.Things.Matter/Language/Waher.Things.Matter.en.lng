		<Namespace name="Waher.Things.Matter.Commands">
			<String id="1">Identify</String>
			<String id="2">Seconds:</String>
			<String id="3">Number of seconds the device should identify itself. 0 stops identification.</String>
			<String id="4">Device</String>
			<String id="5">Pairing code:</String>
			<String id="6">QR code payload (starting with MT:) or manual pairing code (11 or 21 digits) of the device.</String>
			<String id="7">Node ID:</String>
			<String id="8">Node ID of the new device node. If empty, the product name reported by the device is used.</String>
			<String id="9">Address:</String>
			<String id="10">Optional IP address or host name of the device. If empty, the device is found on the network using DNS-SD.</String>
			<String id="11">Port:</String>
			<String id="12">UDP port of the device, if an address is provided.</String>
			<String id="13">Scan</String>
			<String id="14">Add missing devices.</String>
			<String id="15">If device nodes should be created for devices found in the fabric, that are not represented in the topology.</String>
			<String id="16">Commissioning Window</String>
			<String id="17">Minutes:</String>
			<String id="18">Number of minutes the commissioning window should be open (3-15 minutes).</String>
