<?xml version="1.0" encoding="utf-8" ?>
<Translation xmlns="http://waher.se/Schema/Translation.xsd">
	<Language code="en" name="English">
		<Namespace name="Waher.Things.Matter">
			<String id="1">Matter</String>
			<String id="2">Fabric label:</String>
			<String id="3">Label of the fabric, as presented to devices and other administrators (max 32 characters).</String>
			<String id="4">Vendor ID:</String>
			<String id="5">Vendor ID of the administrator, used when the fabric is created. 65521-65524 (0xFFF1-0xFFF4) are test vendor IDs.</String>
			<String id="6">UDP Port:</String>
			<String id="7">UDP port used by the controller. 0 means a dynamically assigned port.</String>
			<String id="8">Discover devices using DNS-SD (mDNS).</String>
			<String id="9">If DNS-SD (mDNS) should be used to discover commissionable devices, and to find the addresses of commissioned devices.</String>
			<String id="10">Discovery timeout (s):</String>
			<String id="11">Maximum time to search for devices on the network, in seconds.</String>
			<String id="12">Commissioning</String>
			<String id="13">Device attestation:</String>
			<String id="14">How device attestation (verification that the device is a certified Matter device) is to be handled during commissioning.</String>
			<String id="15">Strict: Only commission devices that pass attestation.</String>
			<String id="16">Warn: Commission devices failing attestation, but log a warning.</String>
			<String id="17">Ignore: Do not perform device attestation.</String>
			<String id="18">Trust development and test PAAs.</String>
			<String id="19">If devices with attestation certificates issued by development and test Product Attestation Authorities (PAA) should be accepted.</String>
			<String id="20">Accept test certification declarations.</String>
			<String id="21">If certification declarations signed by the public test key should be accepted. Required for development and test devices.</String>
			<String id="22">Additional PAA folder:</String>
			<String id="23">Optional folder containing additional trusted Product Attestation Authority (PAA) certificates, in DER or PEM format.</String>
			<String id="24">Country code:</String>
			<String id="25">Country code (ISO 3166-1 alpha-2) used when configuring the regulatory settings of devices. XX means unknown.</String>
			<String id="26">Regulatory location:</String>
			<String id="27">Regulatory location of devices.</String>
			<String id="28">Indoor</String>
			<String id="29">Outdoor</String>
			<String id="30">Indoor and outdoor</String>
			<String id="31">Matter Controller</String>
