<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <Authors>Peter Waher</Authors>
    <Company>Waher Data AB</Company>
    <Product>Waher.IoTGateway</Product>
    <Description>Publishes nodes representing SNMP devices on the local area network.</Description>
    <Copyright>Copyright © Waher Data AB 2019-2026. All rights reserved.</Copyright>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/PeterWaher/IoTGateway/tree/master/Things/Waher.Things.Snmp</PackageProjectUrl>
    <PackageIconUrl></PackageIconUrl>
    <RepositoryUrl>https://github.com/PeterWaher/IoTGateway</RepositoryUrl>
    <RepositoryType>GitHub</RepositoryType>
    <PackageTags>IoT SNMP</PackageTags>
    <NeutralLanguage>English</NeutralLanguage>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <PackageIcon>Icon_64x64.png</PackageIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Language\Waher.Things.Snmp.en.lng" />
    <None Include="..\..\Images\Icon_64x64.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Language\Waher.Things.Snmp.en.lng">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Content\Waher.Content.Asn1\Waher.Content.Asn1.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Snmp1\Asn1\RFC1155-SMI.asn1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Snmp1\Asn1\RFC1157-SNMP.asn1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Snmp1\Asn1\RFC1158-MIB.asn1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Snmp1\Asn1\RFC1212.asn1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Snmp1\Asn1\RFC1213-MIB.asn1">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="Snmp1\Asn1\RFC1215.asn1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Snmp2\Asn1\COMMUNITY-BASED-SNMPv2.asn1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Snmp2\Asn1\SNMPv2-CONF.asn1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Snmp2\Asn1\SNMPv2-PDU.asn1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Snmp2\Asn1\SNMPv2-SMI.asn1">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="Snmp2\Asn1\SNMPv2-TC.asn1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
		<Exec Command="&quot;$(ProjectDir)..\..\Utilities\Waher.Utility.Asn1ToCSharp\bin\Debug\net8.0\win-x86\Waher.Utility.Asn1ToCSharp.exe&quot; -n Waher.Things.Snmp.Snmp1 -o &quot;$(ProjectDir)Snmp1&quot; -t -i &quot;$(ProjectDir)Snmp1\Asn1\*.asn1&quot;" />
		<Exec Command="&quot;$(ProjectDir)..\..\Utilities\Waher.Utility.Asn1ToCSharp\bin\Debug\net8.0\win-x86\Waher.Utility.Asn1ToCSharp.exe&quot; -n Waher.Things.Snmp.Snmp2 -o &quot;$(ProjectDir)Snmp2&quot; -t -i &quot;$(ProjectDir)Snmp2\Asn1\*.asn1&quot;" />
	</Target>

</Project>
